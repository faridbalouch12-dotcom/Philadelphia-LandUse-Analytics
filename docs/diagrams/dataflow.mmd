flowchart TD

    %% ── Source datasets ──────────────────────────────────────────────
    subgraph SOURCES["Source datasets"]
        SRC1["Planning Districts — ArcGIS FeatureServer"]
        SRC2["L&I Permits — CARTO SQL API"]
        SRC3["Zoning Base Districts — ArcGIS FeatureServer (5 vintages)"]
        SRC4["ACS 5-Year Estimates — Census Bureau API"]
    end

    %% ── Seeds ────────────────────────────────────────────────────────
    subgraph SEEDS["Seeds  (dbt seeds — static reference data)"]
        SEED_XWALK["seed_zoning_code_crosswalk — hand-authored vintage mapping"]
    end

    %% ── Raw layer ────────────────────────────────────────────────────
    subgraph RAW["Raw layer  (schema: raw)"]
        RAW_DISTRICTS["raw.planning_districts"]
        RAW_PERMITS["raw.li_permits"]
        RAW_ZONING["raw.zoning_base_districts_{year}"]
        RAW_ACS["raw.acs_tract_{period}"]
    end

    %% ── Staging layer ────────────────────────────────────────────────
    subgraph STAGING["Staging layer  (schema: staging / dbt stg_*)"]
        STG_DISTRICTS["stg_planning_districts — CRS validated, land_area_sqmi"]
        STG_PERMITS["stg_li_permits — rename columns, standardize types"]
        STG_ZONING["stg_zoning_base_districts — crosswalk applied, vocab_stable"]
        STG_ACS["stg_acs_tract — geoid standardized, period label, suppress nulls"]
    end

    %% ── Intermediate layer ───────────────────────────────────────────
    subgraph INTERMEDIATE["Intermediate layer  (schema: intermediate / dbt int_*)"]
        INT_PERMITS_ISSUED["int_li_permits_issued — filter status = Issued"]
        INT_PERMITS_DISTRICT["int_li_permits_issued_with_district — spatial join to district"]
        INT_TRACT_OVERLAP["int_tract_district_overlap — raw spatial intersection, pct_tract_area"]
        INT_ZONING_INTERSECT["int_zoning_district_intersections_{year} — zoning × district spatial intersection"]
        INT_ZONING_COMP["int_zoning_district_year_composition_base — area weights per district/zone/year"]
    end

    %% ── Mart layer ───────────────────────────────────────────────────
    subgraph MART["Mart layer  (schema: marts)"]

        subgraph MART_DIMS["Conformed dimensions"]
            DIM_DISTRICT["dim_district"]
            DIM_DATE["dim_date"]
            DIM_ZONING["dim_zoning"]
        end

        subgraph MART_FEATURE["Feature tables"]
            FCT_PERMITS["fct_permits  [G1]"]
            FCT_ACS["fct_tract_acs  [G4]"]
            GEO_BOUNDS["geo_district_boundaries  [E8]"]
        end

        subgraph MART_ROLLUP["Rollup + Bridge tables"]
            FCT_ZONING["fct_district_year_zoning_composition  [G2]"]
            MART_BRIDGE["bridge_tract_district_overlap  [G3]"]
        end
    end

    %% ── Analytics layer ──────────────────────────────────────────────
    subgraph ANALYTICS["Analytics layer  (schema: analytics / dbt agg_*)"]
        AGG_ACS["agg_district_acs_attributes_hist  [G6]"]
    end

    %% ── BI layer ─────────────────────────────────────────────────────
    subgraph BI["BI layer  (Metabase)"]
        DB1["District Change Explorer"]
    end

    %% ── Data flows ───────────────────────────────────────────────────

    SRC1 --> RAW_DISTRICTS
    SRC2 --> RAW_PERMITS
    SRC3 --> RAW_ZONING
    SRC4 --> RAW_ACS

    RAW_DISTRICTS --> STG_DISTRICTS
    RAW_PERMITS   --> STG_PERMITS
    RAW_ZONING    --> STG_ZONING
    RAW_ACS       --> STG_ACS
    SEED_XWALK    --> STG_ZONING

    STG_PERMITS          --> INT_PERMITS_ISSUED
    INT_PERMITS_ISSUED   --> INT_PERMITS_DISTRICT
    STG_DISTRICTS        --> INT_PERMITS_DISTRICT
    STG_DISTRICTS        --> INT_TRACT_OVERLAP
    STG_ACS              --> INT_TRACT_OVERLAP
    STG_ZONING           --> INT_ZONING_INTERSECT
    STG_DISTRICTS        --> INT_ZONING_INTERSECT
    INT_ZONING_INTERSECT --> INT_ZONING_COMP

    STG_DISTRICTS        --> DIM_DISTRICT
    STG_ZONING           --> DIM_ZONING

    STG_DISTRICTS        --> GEO_BOUNDS
    INT_PERMITS_DISTRICT --> FCT_PERMITS
    STG_ACS              --> FCT_ACS

    INT_ZONING_COMP   --> FCT_ZONING
    INT_TRACT_OVERLAP --> MART_BRIDGE

    FCT_ACS     --> AGG_ACS
    MART_BRIDGE --> AGG_ACS

    FCT_PERMITS --> DB1
    FCT_ZONING  --> DB1
    AGG_ACS     --> DB1

    %% ── Notes ─────────────────────────────────────────────────────────
