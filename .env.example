# .env.example — Philadelphia Land Use Analytics
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# PostgreSQL connection (used by Python loaders and dbt via env_var())
# ---------------------------------------------------------------------------

# Hostname of the Postgres server. Use 'localhost' when connecting from the
# host machine; use the Docker service name (e.g. 'db') from inside Compose.
POSTGRES_HOST=localhost

# Port Postgres listens on. Default is 5432.
POSTGRES_PORT=5432

# Name of the target database.
POSTGRES_DB=philly_dw

# Database user with read/write access to the warehouse schemas.
POSTGRES_USER=philly

# Password for the database user above.
POSTGRES_PASSWORD=changeme


# ---------------------------------------------------------------------------
# Metabase connection (used by user interface))
# ---------------------------------------------------------------------------

# Database type. Default is 'postgres'.
MB_DB_TYPE=postgres
# Name of the database to use for Metabase's internal data.
MB_DB_DBNAME=philly_dw
# Metabase database port. Default is 5432.
MB_DB_PORT=5432
# Username for the Metabase database. 
MB_DB_USER=philly
# Password for the Metabase database user.
MB_DB_PASS=changeme
# Hostname of the Metabase database server. Use 'localhost' when connecting from the
MB_DB_HOST=postgres_philly_dw
# Port Metabase listens on. Default is 3000.
METABASE_PORT=3000
MB_DB_FILE_PATH=/metabase-data/metabase.db