# ignore all files in the large_data directory
# large_data directory should have files no larger than 10 MB.
/large_data/
books/
books/*.pdf
# ignore all shapefiles files and geogrpahic data as they tend to get very large.
*.shp
*.gpkg
*.dbf
*.prj
*.shx
*.cpg

# ignore enviroment file
# Environment variables
.env
.env.local
# ignore virtual enviroments
.venv/
*.json
*.csv                          # ignore all CSVs by default
!data/samples/*.csv            # except intentional small samples
!tests/fixtures/*.csv          # except test fixtures

*.pyc
.ipynb_checkpoints/
__pycache__/
*.egg-info/

*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Temporary files
*.tmp
*.temp

.ipynb_checkpoints/
*.ipynb_checkpoints

.DS_Store
Thumbs.db

# Claude session notes (private, not for version control)
notes/claude_sessions/
arhive/

# Serena IDE plugin
.serena/

# dbt artifacts
dbt/philly_dw/target/
dbt/philly_dw/logs/
dbt/philly_dw/.user.yml
dbt/philly_dw/dbt_packages/
